# Path to Ableton Live's Extension Host module on this machine.
# Used by @ableton-extensions/cli (npm start) to launch the extension host.
# Copy this file to .env and set it for your own install.
#
# Windows: C:\ProgramData\Ableton\Live 12 Beta\Program\ExtensionHost\ExtensionHostNodeModule.node
# macOS:   /Applications/Ableton Live 12 Beta.app/Contents/App-Resources/ExtensionHost/ExtensionHostNodeModule.node
EXTENSION_HOST_PATH=
